<div
  class="weather-forecast"
  data-temperature-celsius="{{ temperature }}"
>
  <p class="weather-forecast__temperature-wrapper">
    {{ 'Current temperature:'|t }}
    <strong class="weather-forecast__temperature">
      {{ temperature }} °C
    </strong>

    <button
      type="button"
      class="weather-forecast__unit-toggle"
      aria-pressed="false"
    >
      {{ 'Show °F'|t }}
    </button>
  </p>

  <p>
    {{ 'Weather code:'|t }}
    <strong>{{ weather_code }}</strong>
  </p>

  <small class="weather-forecast__attribution">
    {{ 'Weather data by'|t }}
    <a href="https://open-meteo.com/" rel="noopener noreferrer">
      Open-Meteo.com
    </a>
  </small>
</div>
